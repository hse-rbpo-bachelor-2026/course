# Текстовые файлы нормализуются в репозитории с переводами строк LF.
* text=auto

*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.sh text eol=lf

# Сценарии Windows сохраняют переводы строк CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Двоичные учебные и офисные материалы не нормализуются.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.docx binary
*.xlsx binary
*.pptx binary
